NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=openrubberdocks
DB_SYNCHRONIZE=true

# Docker Postgres Container Compatibility (mirrors DB_* above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=openrubberdocks

# JWT Secrets (minimum 16 chars, 32+ bytes hex recommended)
JWT_ACCESS_SECRET=replace_this_with_a_secure_jwt_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_this_with_a_secure_jwt_refresh_secret_at_least_32_chars

# Security / Hashing
BCRYPT_SALT_ROUNDS=12

# Core Administrator Initial Seed Credentials
CORE_ADMIN_USERNAME=Core Administrator
CORE_ADMIN_HANDLE=coreadmin
CORE_ADMIN_PASSWORD=supersecretpassword

# Model Context Protocol (MCP) Server for AI Agents
ENABLE_MCP=true
MCP_BASE_PATH=/mcp
