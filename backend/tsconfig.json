{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@common/*": ["src/common/*"],
      "@commonCommands/*": ["src/commands/*"],
      "@commonPipes/*": ["src/common/pipes/*"],
      "@commonDecorators/*": ["src/common/decorators/*"],
      "@commonExceptions/*": ["src/common/exceptions/*"],
      "@commonGuards/*": ["src/common/guards/*"],
      "@commonInterceptors/*": ["src/common/interceptors/*"],
      "@commonInterface/*": ["src/common/interface/*"],
      "@commonUtils/*": ["src/common/utils/*"],
      "@config/*": ["src/config/*"],
      "@database/*": ["src/database/*"],
      "@modules/*": ["src/modules/*"],
      "@moduleAuth/*":["src/modules/auth/*"],
      "@moduleUsers/*": ["src/modules/users/*"],
      "@moduleWorkspace/*": ["src/modules/workspace/*"],
      "@moduleFiles/*": ["src/modules/files/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
